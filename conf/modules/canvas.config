params {
    samplesheet       = null

    // Reference files — update paths to match your installation
    genomedir         = null   // Canvas genome reference directory
    reference         = null   // kmer.fa
    filter13          = null   // filter13.bed
    male_ploidy_vcf   = null   // male_hg38.vcf
    female_ploidy_vcf = null   // female_hg38.vcf

    // Optional VCF reformat step (requires fasta)
    run_vcfreformat        = false
    fasta                  = null
    canvas_save_normals    = false
    canvas_length_filtered = false
    canvas_qual_filtered   = false

    outdir            = "./results"
}

process {
    withLabel: process_high {
        cpus   = 8
        memory = '32 GB'
        time   = '24 h'
    }

    withLabel: process_low {
        cpus   = 2
        memory = '8 GB'
        time   = '4 h'
    }

    withName: 'CANVAS_GERMLINE' {
        stageInMode = 'copy'
        publishDir = [
            path: "${params.outdir}/canvas",
            mode: 'copy',
            pattern: '*.vcf.gz'
        ]
    }

    withName: 'CANVAS_CREATESEG' {
        publishDir = [
            path: "${params.outdir}/canvas",
            mode: 'copy',
            pattern: '*.seg'
        ]
    }

    withName: 'CANVAS_VCF_REFORMAT' {
        ext.args = [
            params.canvas_save_normals    ? '-n' : '',
            params.canvas_length_filtered ? '-l' : '',
            params.canvas_qual_filtered   ? '-q' : ''
        ].join(' ').trim()
        publishDir = [
            path: "${params.outdir}/canvas",
            mode: 'copy',
            pattern: '*.vcf'
        ]
    }
}

profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}
